# =====================================================================
# Dinesh K Portfolio - Telegram Bot Configuration
# =====================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# 2. (Optional) Your personal Telegram User ID (to prevent anyone else from editing)
# When you message the bot /start the first time, it will tell you your User ID!
TELEGRAM_ALLOWED_USER_ID=

# 3. (Optional) GitHub Personal Access Token (PAT)
# If provided, the bot will automatically commit data.json to GitHub directly!
GITHUB_TOKEN=
GITHUB_REPO=Gateway-ne/DineshK_Portfolio
